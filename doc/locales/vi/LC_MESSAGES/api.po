msgid "setDuty(uint8_t channel, uint16_t ticks): Set one channel from 0 to 4095."
msgstr "setDuty(uint8_t channel, uint16_t ticks): Đặt một kênh từ 0 đến 4095."

#: ../../../source/_api_autogen.rst:55
msgid "ServoOut"
msgstr ""

#: ../../../source/_api_autogen.rst:57
msgid "begin(): Start the servo PCA9685 at 50 Hz."
msgstr "begin(): Khởi động PCA9685 của servo ở 50 Hz."

#: ../../../source/_api_autogen.rst:58
msgid "write(uint8_t channel, uint8_t angle): Move a servo from 0 to 180 degrees."
msgstr "write(uint8_t channel, uint8_t angle): Quay servo từ 0 đến 180 độ."

#: ../../../source/_api_autogen.rst:59
msgid "release(uint8_t channel): Stop driving a servo."
msgstr "release(uint8_t channel): Ngừng cấp xung cho servo."

