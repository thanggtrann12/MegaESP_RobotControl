#: ../../../source/_api_autogen.rst:32
msgid "run(int16_t pwm): Run at a signed PWM from -255 to 255."
msgstr "run(int16_t pwm): Chạy với PWM có dấu từ -255 đến 255."

#: ../../../source/_api_autogen.rst:33
msgid "brake(): Short the motor terminals."
msgstr "brake(): Nối tắt hai đầu động cơ để hãm."

#: ../../../source/_api_autogen.rst:34
msgid "stop(): Release the motor."
msgstr "stop(): Thả động cơ (quay tự do)."

#: ../../../source/_api_autogen.rst:37
msgid "MotorTA6586"
msgstr ""

#: ../../../source/_api_autogen.rst:39
msgid ""
"run(int16_t), brake(), stop(): Drive one TA6586 through two PCA9685 "
"channels."
msgstr "run(int16_t), brake(), stop(): Điều khiển một TA6586 qua hai kênh PCA9685."

#: ../../../source/_api_autogen.rst:42
msgid "MotorBank"
msgstr ""

#: ../../../source/_api_autogen.rst:44
msgid "begin(uint16_t pwmHz): Start the PCA9685 and stop all six motors."
msgstr "begin(uint16_t pwmHz): Khởi động PCA9685 và dừng cả sáu động cơ."

#: ../../../source/_api_autogen.rst:45
msgid "motor(uint8_t slot): Return the motor of slot 0 to 5."
msgstr "motor(uint8_t slot): Trả về động cơ ở cổng 0 đến 5."

#: ../../../source/_api_autogen.rst:46
msgid "stopAll(): Release every motor."
msgstr "stopAll(): Thả tất cả động cơ."

