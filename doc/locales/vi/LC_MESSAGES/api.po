msgid "Drive and Configuration"
msgstr "Drive và cấu hình"

#: ../../../source/_api_autogen.rst:73
msgid "Drive"
msgstr ""

#: ../../../source/_api_autogen.rst:75
msgid ""
"assign(WheelRole, IMotor*, bool inverted): Connect a motor to a wheel "
"role."
msgstr ""
"assign(WheelRole, IMotor*, bool inverted): Nối một động cơ với một vai "
"trò bánh."

#: ../../../source/_api_autogen.rst:76
msgid "clearMotors(): Disconnect every motor."
msgstr "clearMotors(): Ngắt kết nối mọi động cơ."

#: ../../../source/_api_autogen.rst:77
msgid ""
"setChassis(Chassis, const Mix* custom): Select a chassis preset or the "
"custom table."
msgstr ""
"setChassis(Chassis, const Mix* custom): Chọn khung gầm có sẵn hoặc bảng "
"tùy chỉnh."

#: ../../../source/_api_autogen.rst:78
msgid "setPwmLimit(uint8_t), setAccelStep(uint8_t): Set the output limits."
msgstr "setPwmLimit(uint8_t), setAccelStep(uint8_t): Đặt các giới hạn ngõ ra."

#: ../../../source/_api_autogen.rst:79
msgid "ready() const: True when every wheel the chassis needs has a motor."
msgstr "ready() const: Trả về true khi mọi bánh mà khung gầm cần đều có động cơ."

#: ../../../source/_api_autogen.rst:80
msgid ""
"move(int8_t throttle, int8_t strafe, int8_t rotation): Mix a command into"
" wheel speeds."
msgstr ""
"move(int8_t throttle, int8_t strafe, int8_t rotation): Trộn một lệnh "
"thành tốc độ từng bánh."

#: ../../../source/_api_autogen.rst:81
msgid "stop(): Release every motor."
msgstr "stop(): Thả mọi động cơ."

