msgid "write(uint8_t pin, bool high): Write a digital output."
msgstr "write(uint8_t pin, bool high): Ghi ngõ ra số."

#: ../../../source/_api_autogen.rst:66
msgid "read(uint8_t pin): Read a digital input."
msgstr "read(uint8_t pin): Đọc ngõ vào số."

#: ../../../source/_api_autogen.rst:67
msgid "readAnalog(uint8_t channel): Read an analog input."
msgstr "readAnalog(uint8_t channel): Đọc ngõ vào analog."

