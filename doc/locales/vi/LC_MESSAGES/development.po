msgid "``Hmi`` handles touchscreen commands and calls ``Robot``."
msgstr "``Hmi`` đọc màn hình cảm ứng và gọi ``Robot``."

#: ../../../source/development.rst:10
msgid ""
"``EspNowLink`` validates remote packets and queues them; ``update()`` "
"delivers them to ``Robot::onRemote()`` from the main loop."
msgstr ""

#: ../../../source/development.rst:11
#, fuzzy
msgid ""
"``Robot::update()`` applies drive commands on a 20 ms tick and stops "
"after the 500 ms link timeout."
msgstr ""
"``Robot::update()`` chạy mỗi vòng lặp, áp dụng lệnh hiện tại cho "
"``Drive`` mỗi 20 ms và thực thi watchdog 500 ms."

#: ../../../source/development.rst:13
