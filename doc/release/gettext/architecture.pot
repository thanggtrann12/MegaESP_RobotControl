msgid "The ESP32-S3:"
msgstr ""

#: ../../../source/architecture.rst:10
msgid "Drives two-wheel, tank, 4-wheel omni, mecanum, 6-wheel and custom chassis"
msgstr ""

#: ../../../source/architecture.rst:11
msgid "Runs six DC motors (M1 to M6) and up to sixteen servos through PCA9685 chips"
msgstr ""

#: ../../../source/architecture.rst:12
msgid "Exposes digital and analog pins as plain inputs or outputs"
msgstr ""

#: ../../../source/architecture.rst:13
msgid "Takes commands from the TJC touchscreen over UART and from the ESP-NOW remote directly"
msgstr ""

#: ../../../source/architecture.rst:14
msgid "Stops all motors when the command link is lost"
msgstr ""

#: ../../../source/architecture.rst:15
msgid "Stores the robot configuration in EEPROM"
msgstr ""

