#: ../../../source/communication.rst:2
msgid "Communication Protocols & ESP-NOW"
msgstr ""

#: ../../../source/communication.rst:4
msgid "The ESP32-S3 has one UART link and one wireless link. Both carry commands that end up in the same ``Robot`` object through the ``SWC_Robot_*`` facade."
msgstr ""

#: ../../../source/communication.rst:6
msgid "**Serial1:** TJC touchscreen, ASCII text commands."
msgstr ""

#: ../../../source/communication.rst:7
msgid "**ESP-NOW:** Remote control packets received directly by the ESP32-S3."
msgstr ""

#: ../../../source/communication.rst:10
msgid "TJC Protocol (Serial1)"
msgstr ""

#: ../../../source/communication.rst:12
msgid "A command is ASCII text with comma separated fields. It ends with three ``0xFF`` bytes (what the TJC sends) or with a newline. Every reply ends with three ``0xFF`` bytes."
msgstr ""

#: ../../../source/communication.rst:14
msgid "Motor slots are numbered from 1 (M1 to M6)."
msgstr ""

#: ../../../source/communication.rst:15
msgid "Wheel roles are numbered 0 to 6; see :doc:`configuration`."
msgstr ""

#: ../../../source/communication.rst:16
msgid "A command is answered with ``OK,<NAME>`` or ``ERR,<NAME>``, except where noted."
msgstr ""

#: ../../../source/communication.rst:19
msgid "Configuration"
msgstr ""

#: ../../../source/communication.rst:25
#: ../../../source/communication.rst:51
#: ../../../source/communication.rst:71
msgid "Command"
msgstr ""

