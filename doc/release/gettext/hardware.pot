#: ../../../source/hardware.rst:6
msgid "The robot controller is an **Arduino Mega 2560** that talks to its outputs over I2C. Two **PCA9685** PWM chips generate all motor and servo signals; the Mega itself only provides the I2C bus, two UARTs and plain I/O pins."
msgstr ""

#: ../../../source/hardware.rst:8
msgid "**PCA9685 at 0x40:** drives six **TA6586** motor drivers at 1 kHz."
msgstr ""

#: ../../../source/hardware.rst:9
msgid "**PCA9685 at 0x41:** drives servos at 50 Hz."
msgstr ""

#: ../../../source/hardware.rst:11
msgid "One PCA9685 has a single PWM frequency, so motors and servos need separate chips."
msgstr ""

#: ../../../source/hardware.rst:14
msgid "Motor Slots"
msgstr ""

#: ../../../source/hardware.rst:16
msgid "Each motor slot uses two adjacent PCA9685 channels connected to the two inputs of one TA6586."
msgstr ""

