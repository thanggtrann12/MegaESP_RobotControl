#: ../../source/configuration.rst:2
msgid "Chassis & Motor Configuration"
msgstr "Cấu hình khung gầm và động cơ"

#: ../../source/configuration.rst:5
msgid "Concepts"
msgstr "Khái niệm"

#: ../../source/configuration.rst:7
msgid "**Motor slot:** a physical motor port, M1 to M6."
msgstr "**Cổng động cơ:** một cổng động cơ vật lý, M1 đến M6."

#: ../../source/configuration.rst:8
msgid ""
"**Wheel role:** where a motor sits on the chassis. A slot is assigned one "
"role, or none."
msgstr ""
"**Vai trò bánh:** vị trí của một động cơ trên khung gầm. Mỗi cổng được gán "
"một vai trò hoặc không có."

#: ../../source/configuration.rst:9
msgid ""
"**Chassis:** a mixing table that says how much of throttle, strafe and "
"rotation each wheel receives."
msgstr ""
"**Khung gầm:** một bảng trộn cho biết mỗi bánh nhận bao nhiêu phần của "
"throttle, strafe và rotation."

#: ../../source/configuration.rst:11
msgid "Changing the chassis or the mapping never needs new firmware."
msgstr "Đổi khung gầm hoặc ánh xạ không bao giờ cần firmware mới."

