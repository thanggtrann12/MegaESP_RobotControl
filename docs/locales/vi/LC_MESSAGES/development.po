#: ../../../source/development.rst:2
msgid "Development, Testing & Roadmap"
msgstr "Phát triển, kiểm thử và lộ trình"

#: ../../../source/development.rst:5
msgid "Staged Testing Strategy"
msgstr "Chiến lược kiểm thử theo giai đoạn"

#: ../../../source/development.rst:7
msgid "**Motor Test:** Test individual channels manually via HMI."
msgstr "**Kiểm thử động cơ:** Kiểm thử thủ công từng kênh qua HMI."

#: ../../../source/development.rst:8
msgid ""
"**Kinematics Test:** Verify math using simulated inputs without physical "
"movement."
msgstr ""
"**Kiểm thử động học:** Xác minh phép tính bằng đầu vào mô phỏng mà không cần "
"chuyển động vật lý."

#: ../../../source/development.rst:9
msgid ""
"**Wireless Test:** Validate ESP-NOW packet sequence numbers and CRC "
"checks."
msgstr ""
"**Kiểm thử không dây:** Xác thực số thứ tự gói ESP-NOW và kiểm tra CRC."

#: ../../../source/development.rst:10
msgid ""
"**Integration Test:** Execute full end-to-end testing from remote control"
" to physical movement."
msgstr ""
"**Kiểm thử tích hợp:** Thực hiện kiểm thử end-to-end đầy đủ từ điều khiển từ "
"xa đến chuyển động thực tế."

#: ../../../source/development.rst:13
msgid "Current Status & Roadmap"
msgstr "Trạng thái hiện tại và lộ trình"

#: ../../../source/development.rst:15
msgid ""
"**Phase 1 — Core Motor System:** Arduino Mega 2560 motor control & basic "
"abstraction."
msgstr ""
"**Giai đoạn 1 — Hệ động cơ cốt lõi:** Điều khiển động cơ trên Arduino Mega "
"2560 và lớp trừu tượng cơ bản."

#: ../../../source/development.rst:16
msgid "**Phase 2 — HMI:** TJC display interface, manual testing, simulation mode."
msgstr ""
"**Giai đoạn 2 — HMI:** Giao diện hiển thị TJC, kiểm thử thủ công, chế độ mô "
"phỏng."

#: ../../../source/development.rst:17
msgid ""
"**Phase 3 — Configurable Robot:** EEPROM storage, motor role mapping, "
"inversion settings."
msgstr ""
"**Giai đoạn 3 — Robot có thể cấu hình:** Lưu trữ EEPROM, ánh xạ vai trò động "
"cơ, cài đặt đảo chiều."

#: ../../../source/development.rst:18
msgid ""
"**Phase 4 — Wireless Remote:** ESP-NOW communication link with timeout "
"watchdog."
msgstr ""
"**Giai đoạn 4 — Điều khiển từ xa không dây:** Liên kết truyền thông ESP-NOW "
"kèm watchdog timeout."

#: ../../../source/development.rst:19
msgid ""
"**Phase 5 — Multi-Kinematics:** Runtime switching between Differential, "
"Mecanum, and Omni drive models."
msgstr ""
"**Giai đoạn 5 — Đa động học:** Chuyển đổi thời gian chạy giữa các mô hình "
"truyền động Differential, Mecanum và Omni."

