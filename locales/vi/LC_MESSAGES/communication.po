#: ../../../source/communication.rst:2
msgid "Communication Protocols & ESP-NOW"
msgstr "Giao thức truyền thông và ESP-NOW"

#: ../../../source/communication.rst:5
msgid "Serial Protocol (ASCII Line-Based)"
msgstr "Giao thức Serial (ASCII theo từng dòng)"

#: ../../../source/communication.rst:7
msgid ""
"Communication between TJC Screen / Remote Bridge and Arduino Mega uses "
"structured ASCII strings."
msgstr ""
"Giao tiếp giữa màn hình TJC / cầu nối Remote và Arduino Mega sử dụng chuỗi "
"ASCII có cấu trúc."

#: ../../../source/communication.rst:10
msgid "TJC/Remote -> Robot Mega"
msgstr "TJC/Remote -> Robot Mega"

#: ../../../source/communication.rst:16
msgid "Command Format"
msgstr "Định dạng lệnh"

#: ../../../source/communication.rst:17
msgid "Action Description"
msgstr "Mô tả hành động"

#: ../../../source/communication.rst:18
msgid "``CMD_JOY:<Vx>,<Vy>,<Wz>``"
msgstr "``CMD_JOY:<Vx>,<Vy>,<Wz>``"

#: ../../../source/communication.rst:19
msgid "Passes velocity vector inputs normalized within $[-1.0, 1.0]$."
msgstr "Truyền vector vận tốc đầu vào đã được chuẩn hóa trong khoảng $[-1.0, 1.0]$."

#: ../../../source/communication.rst:20
msgid "``CMD_MODE:<0-4>``"
msgstr "``CMD_MODE:<0-4>``"

#: ../../../source/communication.rst:21
msgid "Switches kinematic mode profile at runtime."
msgstr "Chuyển profile chế độ động học trong thời gian chạy."

#: ../../../source/communication.rst:22
msgid "``CMD_MAP:<ID>,<ROLE>``"
msgstr "``CMD_MAP:<ID>,<ROLE>``"

#: ../../../source/communication.rst:23
msgid ""
"Maps physical motor channel ``<ID>`` to a logical role (e.g., "
"``CMD_MAP:0,FL``)."
msgstr ""
"Ánh xạ kênh động cơ vật lý ``<ID>`` sang một vai trò logic (ví dụ: "
"``CMD_MAP:0,FL``)."

#: ../../../source/communication.rst:24
msgid "``CMD_ESTOP:1``"
msgstr "``CMD_ESTOP:1``"

#: ../../../source/communication.rst:25
msgid "Triggers an immediate emergency stop."
msgstr "Kích hoạt dừng khẩn cấp ngay lập tức."

#: ../../../source/communication.rst:26
msgid "``CMD_M:<ID>,<DIR>,<PWM>``"
msgstr "``CMD_M:<ID>,<DIR>,<PWM>``"

#: ../../../source/communication.rst:27
msgid "Manual press-to-run motor test command."
msgstr "Lệnh kiểm thử động cơ thủ công theo kiểu nhấn để chạy."

#: ../../../source/communication.rst:30
msgid "ESP-NOW Wireless Bridge"
msgstr "Cầu nối không dây ESP-NOW"

#: ../../../source/communication.rst:32
msgid ""
"The wireless link operates over 2.4 GHz ESP-NOW with an observed latency "
"of approximately **~2.5 ms**."
msgstr ""
"Liên kết không dây hoạt động trên ESP-NOW 2.4 GHz với độ trễ quan sát được "
"xấp xỉ **~2.5 ms**."

#: ../../../source/communication.rst:34
msgid "Packets include:"
msgstr "Gói dữ liệu bao gồm:"

#: ../../../source/communication.rst:36
msgid "Protocol Version"
msgstr "Phiên bản giao thức"

#: ../../../source/communication.rst:37
msgid "Sequence Number (detects duplicate, out-of-order, or dropped frames)"
msgstr "Số thứ tự (phát hiện khung trùng lặp, sai thứ tự hoặc bị rơi)"

#: ../../../source/communication.rst:38
msgid "Payload Data (Velocity Vectors, Buttons, Mode Flags)"
msgstr "Dữ liệu payload (vector vận tốc, nút bấm, cờ chế độ)"

#: ../../../source/communication.rst:39
msgid "CRC Verification"
msgstr "Kiểm tra CRC"

